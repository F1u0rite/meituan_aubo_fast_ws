#include <rclcpp/rclcpp.hpp>

#include <sensor_msgs/msg/joint_state.hpp>
#include <std_msgs/msg/string.hpp>

#include <trajectory_msgs/msg/joint_trajectory.hpp>
#include <trajectory_msgs/msg/joint_trajectory_point.hpp>

#include <kdl_parser/kdl_parser.hpp>

#include <kdl/chain.hpp>
#include <kdl/tree.hpp>
#include <kdl/frames.hpp>

#include <kdl/chainfksolverpos_recursive.hpp>
#include <kdl/chainiksolvervel_pinv.hpp>
#include <kdl/chainiksolverpos_nr_jl.hpp>

#include <urdf/model.h>

#include <algorithm>
#include <array>
#include <chrono>
#include <cmath>
#include <memory>
#include <string>
#include <vector>

using namespace std::chrono_literals;


// ============================================================
// AUBO S3 Cartesian Trajectory Planner
//
// ROS 2 Jazzy + C++17 + Orocos KDL
//
// 功能：
// 1. 读取 AUBO S3 URDF
// 2. 读取当前六关节状态
// 3. FK 计算当前末端位姿
// 4. 生成固定姿态的笛卡尔直线路径
// 5. 对每个路径点进行连续 IK
// 6. 检查关节限位
// 7. 检查关节跳变和速度估计
// 8. 检查 FK 误差和关节插值中点偏差
// 9. 发布 JointTrajectory 预览
//
// 安全：
// - 只计算，不执行
// - 不发送 FollowJointTrajectory
// - 不发布任何控制器命令
// - 仅发布 /mtc/cartesian_preview
// ============================================================


class CartesianTrajectoryNode : public rclcpp::Node
{
public:

    CartesianTrajectoryNode()
        : Node("mtc_cartesian_trajectory"),
          current_q_(6),
          q_min_(6),
          q_max_(6)
    {
        // ====================================================
        // 1. ROS Parameters
        // ====================================================

        // 默认沿 base_link X 轴移动 10 mm
        dx_ = declare_parameter<double>("dx", 0.010);
        dy_ = declare_parameter<double>("dy", 0.000);
        dz_ = declare_parameter<double>("dz", 0.000);

        // 20 个路径段，即 21 个关节轨迹点
        steps_ = declare_parameter<int>("steps", 20);

        // 预览轨迹的总时间
        duration_ =
            declare_parameter<double>("duration", 5.0);

        // 相邻路径点最大允许关节变化
        max_joint_step_ =
            declare_parameter<double>("max_joint_step", 0.20);


        // ====================================================
        // 2. URDF Subscription
        // ====================================================

        urdf_sub_ =
            create_subscription<std_msgs::msg::String>(
                "/robot_description",

                rclcpp::QoS(1)
                    .reliable()
                    .transient_local(),

                [this](std_msgs::msg::String::SharedPtr msg)
                {
                    on_urdf(msg);
                }
            );


        // ====================================================
        // 3. Joint States Subscription
        // ====================================================

        joint_sub_ =
            create_subscription<sensor_msgs::msg::JointState>(
                "/joint_states",

                rclcpp::SensorDataQoS(),

                [this](sensor_msgs::msg::JointState::SharedPtr msg)
                {
                    on_joint_state(msg);
                }
            );


        // ====================================================
        // 4. Preview Publisher
        // ====================================================

        preview_pub_ =
            create_publisher<
                trajectory_msgs::msg::JointTrajectory
            >(
                "/mtc/cartesian_preview",

                rclcpp::QoS(1)
                    .reliable()
                    .transient_local()
            );


        // ====================================================
        // 5. Planner Timer
        // ====================================================

        timer_ = create_wall_timer(
            200ms,
            [this]()
            {
                run_planner();
            }
        );


        RCLCPP_INFO(
            get_logger(),
            "========================================"
        );

        RCLCPP_INFO(
            get_logger(),
            "AUBO S3 Cartesian Trajectory Planner"
        );

        RCLCPP_INFO(
            get_logger(),
            "MODE: READ ONLY / PREVIEW"
        );

        RCLCPP_INFO(
            get_logger(),
            "Requested displacement: "
            "X=%.3f Y=%.3f Z=%.3f mm",
            dx_ * 1000.0,
            dy_ * 1000.0,
            dz_ * 1000.0
        );

        RCLCPP_INFO(
            get_logger(),
            "Steps=%d, Duration=%.2f s",
            steps_,
            duration_
        );

        RCLCPP_INFO(
            get_logger(),
            "========================================"
        );
    }


    bool passed() const
    {
        return success_;
    }


private:

    // ========================================================
    // 1. Load URDF and Build KDL Chain
    // ========================================================

    void on_urdf(
        const std_msgs::msg::String::SharedPtr msg)
    {
        if (model_ready_) {
            return;
        }

        urdf::Model robot;

        if (!robot.initString(msg->data)) {
            RCLCPP_ERROR(
                get_logger(),
                "URDF parsing failed"
            );
            return;
        }

        KDL::Tree tree;

        if (!kdl_parser::treeFromString(
                msg->data,
                tree)) {

            RCLCPP_ERROR(
                get_logger(),
                "KDL tree creation failed"
            );
            return;
        }

        if (!tree.getChain(
                "base_link",
                "ee_link",
                chain_)) {

            RCLCPP_ERROR(
                get_logger(),
                "Cannot find base_link -> ee_link chain"
            );
            return;
        }

        if (chain_.getNrOfJoints() != 6) {
            RCLCPP_ERROR(
                get_logger(),
                "Expected 6 joints, got %u",
                chain_.getNrOfJoints()
            );
            return;
        }


        // AUBO S3 官方关节顺序
        const std::array<std::string, 6> expected = {
            "shoulder_joint",
            "upperArm_joint",
            "foreArm_joint",
            "wrist1_joint",
            "wrist2_joint",
            "wrist3_joint"
        };


        joint_names_.clear();
        velocity_limits_.clear();

        unsigned int index = 0;

        for (unsigned int i = 0;
             i < chain_.getNrOfSegments();
             ++i)
        {
            const auto &joint =
                chain_.getSegment(i).getJoint();

            if (joint.getType() == KDL::Joint::None) {
                continue;
            }

            const std::string name = joint.getName();

            if (index >= 6 || name != expected[index]) {
                RCLCPP_ERROR(
                    get_logger(),
                    "Unexpected KDL joint order: %s",
                    name.c_str()
                );
                return;
            }

            const auto urdf_joint =
                robot.getJoint(name);

            if (!urdf_joint ||
                urdf_joint->type != urdf::Joint::REVOLUTE ||
                !urdf_joint->limits) {

                RCLCPP_ERROR(
                    get_logger(),
                    "Missing joint limits: %s",
                    name.c_str()
                );
                return;
            }

            const double lower =
                urdf_joint->limits->lower;

            const double upper =
                urdf_joint->limits->upper;

            const double velocity =
                urdf_joint->limits->velocity;

            if (!std::isfinite(lower) ||
                !std::isfinite(upper) ||
                !std::isfinite(velocity) ||
                lower >= upper ||
                velocity <= 0.0) {

                RCLCPP_ERROR(
                    get_logger(),
                    "Invalid URDF limits: %s",
                    name.c_str()
                );
                return;
            }

            q_min_(index) = lower;
            q_max_(index) = upper;

            joint_names_.push_back(name);
            velocity_limits_.push_back(velocity);

            RCLCPP_INFO(
                get_logger(),
                "%s: [%.3f, %.3f] rad, vmax=%.3f rad/s",
                name.c_str(),
                lower,
                upper,
                velocity
            );

            ++index;
        }

        if (index != 6) {
            RCLCPP_ERROR(
                get_logger(),
                "Joint extraction failed"
            );
            return;
        }

        model_ready_ = true;

        RCLCPP_INFO(
            get_logger(),
            "KDL chain ready: %u segments, %u joints",
            chain_.getNrOfSegments(),
            chain_.getNrOfJoints()
        );
    }


    // ========================================================
    // 2. Read Current Joint States
    // ========================================================

    void on_joint_state(
        const sensor_msgs::msg::JointState::SharedPtr msg)
    {
        if (!model_ready_ || planned_) {
            return;
        }

        KDL::JntArray next_q(6);

        for (size_t i = 0; i < 6; ++i)
        {
            auto it = std::find(
                msg->name.begin(),
                msg->name.end(),
                joint_names_[i]
            );

            if (it == msg->name.end()) {
                return;
            }

            const size_t index =
                std::distance(
                    msg->name.begin(),
                    it
                );

            if (index >= msg->position.size()) {
                return;
            }

            const double value =
                msg->position[index];

            if (!std::isfinite(value)) {
                return;
            }

            if (value < q_min_(i) ||
                value > q_max_(i)) {
                return;
            }

            next_q(i) = value;
        }

        current_q_ = next_q;

        state_received_ = true;

        last_state_time_ =
            std::chrono::steady_clock::now();
    }


    // ========================================================
    // 3. Failure Handler
    // ========================================================

    void fail(const std::string &reason)
    {
        RCLCPP_ERROR(
            get_logger(),
            "PLANNING FAILED: %s",
            reason.c_str()
        );

        planned_ = true;
        success_ = false;

        // 不发布失败的部分轨迹
        rclcpp::shutdown();
    }


    // ========================================================
    // 4. Cartesian Planning
    // ========================================================

    void run_planner()
    {
        if (planned_) {
            return;
        }

        if (!model_ready_ || !state_received_) {
            RCLCPP_INFO_THROTTLE(
                get_logger(),
                *get_clock(),
                3000,
                "Waiting for URDF and joint states..."
            );
            return;
        }

        if (
            std::chrono::steady_clock::now() -
            last_state_time_ > 1s
        ) {
            RCLCPP_WARN_THROTTLE(
                get_logger(),
                *get_clock(),
                3000,
                "Joint state is stale"
            );
            return;
        }


        // ====================================================
        // 4.1 Validate Parameters
        // ====================================================

        if (!std::isfinite(dx_) ||
            !std::isfinite(dy_) ||
            !std::isfinite(dz_) ||
            !std::isfinite(duration_) ||
            !std::isfinite(max_joint_step_)) {

            fail("Non-finite parameters");
            return;
        }

        const double distance =
            std::sqrt(
                dx_ * dx_ +
                dy_ * dy_ +
                dz_ * dz_
            );

        if (distance < 1e-6 ||
            distance > 0.030) {

            fail(
                "Preview displacement must be "
                "between 0 and 30 mm"
            );
            return;
        }

        if (steps_ < 5 || steps_ > 200) {
            fail("steps must be between 5 and 200");
            return;
        }

        if (duration_ < 1.0 ||
            duration_ > 30.0) {

            fail("duration must be between 1 and 30 s");
            return;
        }

        if (max_joint_step_ <= 0.0 ||
            max_joint_step_ > 0.5) {

            fail("Invalid max_joint_step");
            return;
        }


        // ====================================================
        // 4.2 Create KDL Solvers
        // ====================================================

        KDL::ChainFkSolverPos_recursive
            fk_solver(chain_);

        KDL::ChainIkSolverVel_pinv
            ik_vel(chain_);

        KDL::ChainIkSolverPos_NR_JL
            ik_solver(
                chain_,
                q_min_,
                q_max_,
                fk_solver,
                ik_vel,
                300,
                1e-6
            );


        // ====================================================
        // 4.3 Compute Start Pose
        // ====================================================

        KDL::Frame start_pose;

        if (
            fk_solver.JntToCart(
                current_q_,
                start_pose
            ) < 0
        ) {
            fail("Start FK failed");
            return;
        }

        KDL::Frame end_pose = start_pose;

        end_pose.p =
            start_pose.p +
            KDL::Vector(dx_, dy_, dz_);


        RCLCPP_INFO(
            get_logger(),
            "---------- Cartesian Planning ----------"
        );

        RCLCPP_INFO(
            get_logger(),
            "Start XYZ: [%.6f, %.6f, %.6f] m",
            start_pose.p.x(),
            start_pose.p.y(),
            start_pose.p.z()
        );

        RCLCPP_INFO(
            get_logger(),
            "Goal  XYZ: [%.6f, %.6f, %.6f] m",
            end_pose.p.x(),
            end_pose.p.y(),
            end_pose.p.z()
        );


        // ====================================================
        // 4.4 Initialize Preview Trajectory
        // ====================================================

        trajectory_msgs::msg::JointTrajectory trajectory;

        trajectory.header.stamp = now();

        trajectory.joint_names = joint_names_;


        // 第一个点：当前关节角
        trajectory_msgs::msg::JointTrajectoryPoint p0;

        p0.positions.resize(6);

        for (size_t j = 0; j < 6; ++j) {
            p0.positions[j] = current_q_(j);
        }

        p0.time_from_start =
            rclcpp::Duration::from_seconds(0.0);

        trajectory.points.push_back(p0);


        KDL::JntArray previous_q = current_q_;

        const double dt =
            duration_ / static_cast<double>(steps_);


        double max_position_error_mm = 0.0;
        double max_rotation_error = 0.0;

        double max_midpoint_error_mm = 0.0;
        double max_joint_delta = 0.0;

        double max_velocity_ratio = 0.0;


        // ====================================================
        // 4.5 Generate Cartesian Waypoints
        // ====================================================

        for (int i = 1; i <= steps_; ++i)
        {
            const double s =
                static_cast<double>(i) /
                static_cast<double>(steps_);


            // ------------------------------------------------
            // Cartesian Desired Pose
            // ------------------------------------------------

            KDL::Frame desired_pose = start_pose;

            desired_pose.p =
                start_pose.p +
                KDL::Vector(
                    dx_ * s,
                    dy_ * s,
                    dz_ * s
                );

            // desired_pose.M 保持原始姿态不变


            // ------------------------------------------------
            // Continuous IK
            // 使用上一个路径点的关节角作为初值
            // ------------------------------------------------

            KDL::JntArray solved_q(6);

            const int ik_ret =
                ik_solver.CartToJnt(
                    previous_q,
                    desired_pose,
                    solved_q
                );

            if (ik_ret < 0) {
                fail(
                    "IK failed at waypoint " +
                    std::to_string(i) +
                    ", code=" +
                    std::to_string(ik_ret)
                );
                return;
            }


            // ------------------------------------------------
            // Joint Limits and Continuity
            // ------------------------------------------------

            for (size_t j = 0; j < 6; ++j)
            {
                const double q =
                    solved_q(j);

                if (!std::isfinite(q) ||
                    q < q_min_(j) ||
                    q > q_max_(j)) {

                    fail(
                        "Joint limit violation at waypoint " +
                        std::to_string(i)
                    );
                    return;
                }

                const double dq =
                    std::abs(
                        solved_q(j) -
                        previous_q(j)
                    );

                max_joint_delta =
                    std::max(
                        max_joint_delta,
                        dq
                    );

                if (dq > max_joint_step_) {
                    fail(
                        "Joint discontinuity at waypoint " +
                        std::to_string(i) +
                        ", joint=" +
                        joint_names_[j]
                    );
                    return;
                }


                // --------------------------------------------
                // Estimated Joint Velocity
                // --------------------------------------------

                const double velocity =
                    dq / dt;

                const double velocity_ratio =
                    velocity /
                    velocity_limits_[j];

                max_velocity_ratio =
                    std::max(
                        max_velocity_ratio,
                        velocity_ratio
                    );

                // 测试阶段保守限制为 URDF vmax 的 50%
                if (velocity_ratio > 0.5) {
                    fail(
                        "Estimated joint velocity too high: " +
                        joint_names_[j]
                    );
                    return;
                }
            }


            // ------------------------------------------------
            // FK Verification
            // ------------------------------------------------

            KDL::Frame actual_pose;

            if (
                fk_solver.JntToCart(
                    solved_q,
                    actual_pose
                ) < 0
            ) {
                fail("Waypoint FK failed");
                return;
            }

            const KDL::Twist pose_error =
                KDL::diff(
                    desired_pose,
                    actual_pose
                );

            const double pos_error_mm =
                pose_error.vel.Norm() * 1000.0;

            const double rot_error =
                pose_error.rot.Norm();


            max_position_error_mm =
                std::max(
                    max_position_error_mm,
                    pos_error_mm
                );

            max_rotation_error =
                std::max(
                    max_rotation_error,
                    rot_error
                );


            if (pos_error_mm > 0.5 ||
                rot_error > 0.002) {

                fail(
                    "FK verification failed at waypoint " +
                    std::to_string(i)
                );
                return;
            }


            // ------------------------------------------------
            // Joint Interpolation Midpoint Check
            //
            // 检查两关节路径点的线性插值中点
            // 是否偏离预期笛卡尔直线
            // ------------------------------------------------

            KDL::JntArray midpoint_q(6);

            for (size_t j = 0; j < 6; ++j) {
                midpoint_q(j) =
                    0.5 * (
                        previous_q(j) +
                        solved_q(j)
                    );
            }

            KDL::Frame midpoint_actual;

            if (
                fk_solver.JntToCart(
                    midpoint_q,
                    midpoint_actual
                ) < 0
            ) {
                fail("Midpoint FK failed");
                return;
            }


            const double mid_s =
                (
                    static_cast<double>(i) - 0.5
                ) /
                static_cast<double>(steps_);


            KDL::Frame midpoint_desired =
                start_pose;

            midpoint_desired.p =
                start_pose.p +
                KDL::Vector(
                    dx_ * mid_s,
                    dy_ * mid_s,
                    dz_ * mid_s
                );


            const KDL::Twist midpoint_error =
                KDL::diff(
                    midpoint_desired,
                    midpoint_actual
                );

            const double midpoint_error_mm =
                midpoint_error.vel.Norm() * 1000.0;

            const double midpoint_rotation_error =
                midpoint_error.rot.Norm();


            max_midpoint_error_mm =
                std::max(
                    max_midpoint_error_mm,
                    midpoint_error_mm
                );


            if (midpoint_error_mm > 0.5 ||
                midpoint_rotation_error > 0.002) {

                fail(
                    "Joint interpolation midpoint deviates "
                    "from Cartesian path at waypoint " +
                    std::to_string(i)
                );
                return;
            }


            // ------------------------------------------------
            // Add JointTrajectory Point
            // ------------------------------------------------

            trajectory_msgs::msg::JointTrajectoryPoint point;

            point.positions.resize(6);

            for (size_t j = 0; j < 6; ++j) {
                point.positions[j] = solved_q(j);
            }

            point.time_from_start =
                rclcpp::Duration::from_seconds(
                    dt * static_cast<double>(i)
                );

            trajectory.points.push_back(point);


            // ------------------------------------------------
            // Logging
            // ------------------------------------------------

            if (
                i == 1 ||
                i % 5 == 0 ||
                i == steps_
            ) {
                RCLCPP_INFO(
                    get_logger(),
                    "Waypoint %02d/%02d: "
                    "XYZ=[%.4f, %.4f, %.4f] m, "
                    "pos_err=%.4f mm",
                    i,
                    steps_,
                    actual_pose.p.x(),
                    actual_pose.p.y(),
                    actual_pose.p.z(),
                    pos_error_mm
                );
            }


            // ------------------------------------------------
            // Update IK Seed
            // ------------------------------------------------

            previous_q = solved_q;
        }


        // ====================================================
        // 4.6 Planning Summary
        // ====================================================

        RCLCPP_INFO(
            get_logger(),
            "========================================"
        );

        RCLCPP_INFO(
            get_logger(),
            "CARTESIAN PLANNING SUCCESS"
        );

        RCLCPP_INFO(
            get_logger(),
            "Cartesian distance: %.3f mm",
            distance * 1000.0
        );

        RCLCPP_INFO(
            get_logger(),
            "Trajectory points: %zu",
            trajectory.points.size()
        );

        RCLCPP_INFO(
            get_logger(),
            "Preview duration: %.3f s",
            duration_
        );

        RCLCPP_INFO(
            get_logger(),
            "Max FK position error: %.6f mm",
            max_position_error_mm
        );

        RCLCPP_INFO(
            get_logger(),
            "Max FK rotation error: %.6f rad",
            max_rotation_error
        );

        RCLCPP_INFO(
            get_logger(),
            "Max midpoint position error: %.6f mm",
            max_midpoint_error_mm
        );

        RCLCPP_INFO(
            get_logger(),
            "Max joint step: %.6f rad",
            max_joint_delta
        );

        RCLCPP_INFO(
            get_logger(),
            "Max estimated velocity / URDF limit: %.2f%%",
            max_velocity_ratio * 100.0
        );


        // ====================================================
        // 4.7 Publish Preview Only
        // ====================================================

        preview_pub_->publish(trajectory);

        planned_ = true;
        success_ = true;


        RCLCPP_INFO(
            get_logger(),
            "Preview published:"
        );

        RCLCPP_INFO(
            get_logger(),
            "/mtc/cartesian_preview"
        );

        RCLCPP_WARN(
            get_logger(),
            "READ ONLY: No robot motion command sent"
        );

        RCLCPP_WARN(
            get_logger(),
            "Collision and acceleration checks "
            "are NOT implemented"
        );

        RCLCPP_INFO(
            get_logger(),
            "Node remains alive for topic inspection."
        );

        RCLCPP_INFO(
            get_logger(),
            "Press Ctrl+C to exit."
        );

        RCLCPP_INFO(
            get_logger(),
            "========================================"
        );
    }


    // ========================================================
    // Member Variables
    // ========================================================

    KDL::Chain chain_;

    KDL::JntArray current_q_;
    KDL::JntArray q_min_;
    KDL::JntArray q_max_;

    std::vector<std::string> joint_names_;
    std::vector<double> velocity_limits_;


    double dx_{0.010};
    double dy_{0.0};
    double dz_{0.0};

    int steps_{20};

    double duration_{5.0};
    double max_joint_step_{0.20};


    bool model_ready_{false};
    bool state_received_{false};

    bool planned_{false};
    bool success_{false};


    std::chrono::steady_clock::time_point
        last_state_time_{};


    rclcpp::Subscription<
        std_msgs::msg::String
    >::SharedPtr urdf_sub_;


    rclcpp::Subscription<
        sensor_msgs::msg::JointState
    >::SharedPtr joint_sub_;


    rclcpp::Publisher<
        trajectory_msgs::msg::JointTrajectory
    >::SharedPtr preview_pub_;


    rclcpp::TimerBase::SharedPtr timer_;
};


// ============================================================
// Main
// ============================================================

int main(int argc, char **argv)
{
    rclcpp::init(argc, argv);

    auto node =
        std::make_shared<CartesianTrajectoryNode>();

    rclcpp::spin(node);

    const bool passed = node->passed();

    if (rclcpp::ok()) {
        rclcpp::shutdown();
    }

    return passed ? 0 : 1;
}